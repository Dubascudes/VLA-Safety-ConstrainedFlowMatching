+    # =================================================================
+    # Obstacle primitive distance functions
+    # =================================================================
+    @torch._dynamo.disable
+    def _guidance_time_scale(self, tau: float) -> float:
+        cfg = self.config
+        
+        if cfg.guidance_schedule == 'flat':
+            return 1.0 if tau > cfg.min_guidance_time else 0.0
+        
+        elif cfg.guidance_schedule == 'bellcurve':
+            if tau < cfg.bell_min_tau or tau > cfg.bell_max_tau:
+                return 0.0
+            return float(np.exp(-0.5 * ((tau - cfg.bell_peak_tau) / cfg.bell_width) ** 2))
+        
+        elif cfg.guidance_schedule == 'posthoc':
+            # No guidance during denoising — correction applied after
+            return 0.0
+        
+        return 1.0
+    def _closest_point_on_box(self, point, box_pos, box_rot, half_extents):
+        local_point = box_rot.T @ (point - box_pos)
+        clamped = np.clip(local_point, -half_extents, half_extents)
+        inside = np.all(np.abs(local_point) <= half_extents)
+
+        if inside:
+            distances_to_faces = half_extents - np.abs(local_point)
+            closest_axis = np.argmin(distances_to_faces)
+            clamped[closest_axis] = np.sign(local_point[closest_axis]) * half_extents[closest_axis]
+            surface_point = box_rot @ clamped + box_pos
+            distance = -distances_to_faces[closest_axis]
+        else:
+            surface_point = box_rot @ clamped + box_pos
+            distance = np.linalg.norm(point - surface_point)
+
+        return surface_point, distance
+
+    def _closest_point_on_sphere(self, point, sphere_pos, radius):
+        direction = point - sphere_pos
+        dist = np.linalg.norm(direction)
+        if dist < 1e-8:
+            return sphere_pos + np.array([radius, 0, 0]), -radius
+        surface = sphere_pos + (direction / dist) * radius
+        return surface, dist - radius
+
+    def _closest_point_on_ellipsoid(self, point, ell_pos, ell_rot, semi_axes):
+        """Closest point on ellipsoid surface to a query point."""
+        # Transform to ellipsoid local frame
+        local = ell_rot.T @ (point - ell_pos)
+        
+        # Normalize to unit sphere
+        normalized = local / semi_axes
+        norm = np.linalg.norm(normalized)
+        
+        if norm < 1e-8:
+            # Point is at center, pick arbitrary surface point
+            surface_local = np.array([semi_axes[0], 0, 0])
+            surface_world = ell_rot @ surface_local + ell_pos
+            return surface_world, -np.min(semi_axes)
+        
+        # Project onto unit sphere, then scale back
+        unit_dir = normalized / norm
+        surface_local = unit_dir * semi_axes
+        surface_world = ell_rot @ surface_local + ell_pos
+        
+        distance = np.linalg.norm(point - surface_world)
+        if norm < 1.0:
+            distance = -distance  # inside
+        
+        return surface_world, distance
+    def _closest_point_on_cylinder(self, point, cyl_pos, cyl_rot, radius, half_height):
+        local = cyl_rot.T @ (point - cyl_pos)
+        radial_dist = np.linalg.norm(local[:2])
+        clamped_z = np.clip(local[2], -half_height, half_height)
+
+        if radial_dist <= radius and np.abs(local[2]) <= half_height:
+            dist_curved = radius - radial_dist
+            dist_cap = half_height - np.abs(local[2])
+            if dist_curved < dist_cap:
+                if radial_dist > 1e-8:
+                    r = local[:2] / radial_dist * radius
+                else:
+                    r = np.array([radius, 0.0])
+                local_surf = np.array([r[0], r[1], local[2]])
+                distance = -dist_curved
+            else:
+                local_surf = np.array([local[0], local[1], np.sign(local[2]) * half_height])
+                distance = -dist_cap
+        else:
+            if radial_dist > 1e-8:
+                r = local[:2] / radial_dist * min(radial_dist, radius)
+            else:
+                r = np.array([0.0, 0.0])
+            local_surf = np.array([r[0], r[1], clamped_z])
+            surface = cyl_rot @ local_surf + cyl_pos
+            return surface, np.linalg.norm(point - surface)
+
+        surface = cyl_rot @ local_surf + cyl_pos
+        return surface, distance
+
+    # =================================================================
+    # Ellipsoid EEF clearance
+    # =================================================================
+
+    def _ellipsoid_surface_distance(self, ellipsoid_center, point):
+        delta = point - ellipsoid_center
+        delta_norm = delta / self.eef_radii
+        norm_dist = np.linalg.norm(delta_norm)
+
+        if norm_dist < 1e-8:
+            return -np.min(self.eef_radii), np.array([0, 0, 1])
+
+        norm_direction = delta_norm / norm_dist
+        surface_point = ellipsoid_center + norm_direction * self.eef_radii
+
+        distance = np.linalg.norm(point - surface_point)
+        if norm_dist < 1.0:
+            distance = -distance
+
+        direction = delta / (np.linalg.norm(delta) + 1e-8)
+        return distance, direction
+
+    def _ellipsoid_to_point_clearance(self, ellipsoid_center, point, point_radius=0.0):
+        surface_dist, direction = self._ellipsoid_surface_distance(ellipsoid_center, point)
+        clearance = surface_dist - point_radius
+        return clearance, direction
+
+    # =================================================================
+    # Per-trajectory-point clearance against actual obstacle geometry
+    # =================================================================
+
+    def _clearance_to_obstacle(self, eef_pos, obstacle: ObstacleGeometry):
+        """Compute clearance between ellipsoidal EEF at eef_pos and an obstacle."""
+        t = obstacle.geom_type
+
+        if t == self.SPHERE:
+            obs_surface, _ = self._closest_point_on_sphere(
+                eef_pos, obstacle.position, obstacle.size[0]
+            )
+        elif t == self.BOX or t == self.MESH:
+            obs_surface, _ = self._closest_point_on_box(
+                eef_pos, obstacle.position, obstacle.rotation, obstacle.size[:3]
+            )
+        elif t == self.CYLINDER:
+            obs_surface, _ = self._closest_point_on_cylinder(
+                eef_pos, obstacle.position, obstacle.rotation,
+                obstacle.size[0], obstacle.size[1]
+            )
+        elif t == self.ELLIPSOID:
+            obs_surface, _ = self._closest_point_on_ellipsoid(
+                eef_pos, obstacle.position, obstacle.rotation, obstacle.size
+            )
+        else:
+            obs_surface = obstacle.position.copy()
+
+        clearance, direction = self._ellipsoid_to_point_clearance(
+            eef_pos, obs_surface, point_radius=0.0
+        )
+        return clearance, direction
+
+    def _compute_trajectory_clearances(self, trajectory, obstacles: List[ObstacleGeometry]):
+        """Compute min clearance at each trajectory point against ALL obstacles."""
+        clearances = []
+        directions = []
+
+        for pos in trajectory:
+            min_clearance = float('inf')
+            min_direction = np.array([0.0, 0.0, 1.0])
+
+            for obs in obstacles:
+                clearance, direction = self._clearance_to_obstacle(pos, obs)
+                if clearance < min_clearance:
+                    min_clearance = clearance
+                    min_direction = direction
+
+            clearances.append(min_clearance)
+            directions.append(min_direction)
+
+        return np.array(clearances), np.array(directions)
+
+    # =================================================================
+    # Trajectory prediction
+    # =================================================================
