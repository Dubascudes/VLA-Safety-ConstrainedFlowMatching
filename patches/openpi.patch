+        logging.error("Safety guidance not available - SafetyConfig not found")
+        return False
+    
+    # Get the underlying model
+    model = getattr(policy, '_model', None)
+    if model is None:
+        logging.error("Could not access policy._model")
+        return False
+    
+    # Check if model supports safety guidance
+    if not hasattr(model, 'enable_safety_guidance'):
+        logging.error(
+            "Model does not have enable_safety_guidance method. "
+            "Make sure you're using the patched pi0_pytorch_safe.py"
+        )
+        return False
+    
