+@dataclass
+class SafetyConfig:
+    """Configuration for safety-guided flow matching with ellipsoidal EEF."""
+    safety_margin: float = 0.01
+    min_guidance_time: float = 0.0
+    dt: float = 0.01
+    action_scale: float = 0.2
+    eef_ellipsoid_radii: tuple = (0.06, 0.12, 0.11)
+    cbf_gamma: float = 0.9
+    guidance_schedule: str = 'flat'
+    bell_peak_tau: float = 0.45
+    bell_width: float = 0.20
+    bell_min_tau: float = 0.05
+    bell_max_tau: float = 0.85
