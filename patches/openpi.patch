+    @torch._dynamo.disable
+    def _compute_cbf_qp_guidance(self, actions, eef_pos, obstacles: List[ObstacleGeometry]):
+        """Minimum-norm CBF correction via QP."""
+        from scipy.optimize import minimize
+
+        dt = self.config.dt
+        gamma = self.config.cbf_gamma
+        n_actions = len(actions)
+
+        # Check if any correction needed
+        orig_trajectory = self._predict_trajectory(actions, eef_pos)
+        orig_clearances, _ = self._compute_trajectory_clearances(orig_trajectory, obstacles)
+
+        needs_correction = False
+        for j in range(1, len(orig_trajectory)):
+            h_curr = orig_clearances[j - 1] - self.config.safety_margin
+            h_next = orig_clearances[j] - self.config.safety_margin
+            if (1 - gamma) * h_curr - h_next > 0:
+                needs_correction = True
+                break
+
+        if not needs_correction:
+            return None
+
+        def objective(delta_flat):
+            return 0.5 * np.dot(delta_flat, delta_flat)
+
+        def objective_grad(delta_flat):
+            return delta_flat
+
+        def cbf_constraints(delta_flat):
+            delta = delta_flat.reshape(n_actions, 3)
+            corrected = actions.copy()
+            corrected[:, :3] += delta
+
+            trajectory = self._predict_trajectory(corrected, eef_pos)
+            clearances, _ = self._compute_trajectory_clearances(trajectory, obstacles)
+
+            constraints = []
+            for j in range(1, len(trajectory)):
+                h_curr = clearances[j - 1] - self.config.safety_margin
+                h_next = clearances[j] - self.config.safety_margin
+                constraints.append(h_next - (1 - gamma) * h_curr)
+
+            return np.array(constraints)
+
+        delta0 = np.zeros(n_actions * 3)
+
+        result = minimize(
+            objective,
+            delta0,
+            jac=objective_grad,
+            method='SLSQP',
+            constraints={'type': 'ineq', 'fun': cbf_constraints},
+            options={'maxiter': 50, 'ftol': 1e-8},
+        )
+
+        if not result.success:
+            return self._compute_cbf_greedy_fallback(actions, eef_pos, obstacles)
 
+        delta = result.x.reshape(n_actions, 3)
+        gradient = np.zeros_like(actions)
+        gradient[:, :3] = delta
+
+        if np.linalg.norm(gradient) < 1e-8:
+            return None
+
+        return gradient
