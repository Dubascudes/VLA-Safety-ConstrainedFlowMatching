+    def _predict_trajectory(self, actions, eef_pos):
+        dt = self.config.dt
+        positions = [eef_pos.copy()]
+        pos = eef_pos.copy()
+        for action in actions:
+            pos = pos + action[:3] * dt
+            positions.append(pos.copy())
+        return np.array(positions)
