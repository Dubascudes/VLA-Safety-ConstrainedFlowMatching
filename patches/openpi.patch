+            clearances, directions = self._compute_trajectory_clearances(trajectory, obstacles)
+
+            h_curr = clearances[j - 1] - self.config.safety_margin
+            h_next = clearances[j] - self.config.safety_margin
+
+            cbf_violation = (1 - gamma) * h_curr - h_next
