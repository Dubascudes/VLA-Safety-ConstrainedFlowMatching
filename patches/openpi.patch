+@dataclass
+class ObstacleGeometry:
+    """Obstacle described by its primitive geometry."""
+    geom_type: int
+    position: np.ndarray
+    rotation: np.ndarray
+    size: np.ndarray
+
+
+class SafetyGuidance:
+    """Safety guidance using CBF-QP over predicted trajectories."""
+    
+    SPHERE = 2
+    CYLINDER = 5
+    BOX = 6
+    MESH = 7
+    ELLIPSOID = 4
+    def __init__(self, config: Optional[SafetyConfig] = None):
+        self.config = config or SafetyConfig()
+        radii = np.array(self.config.eef_ellipsoid_radii)
+        self.eef_radii = radii
