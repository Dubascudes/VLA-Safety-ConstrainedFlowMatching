+@dataclass
+class FlowGuidanceTrace:
+    """Records triple-pass data during guided flow matching for ablation.
+    
+    Three fully independent denoising trajectories from the same initial noise:
+    - unguided:  no corrections
+    - guided:    corrections during denoising (SafeLIBERO method)  
+    - posthoc:   unguided denoising + single correction on final actions
+    """
+    flow_times: list              # tau values (shared across passes)
+    unguided_x_t: list            # x_t at each step, fully unguided
+    guided_x_t: list              # x_t at each step, guided during denoising
+    posthoc_x_t: list             # same as unguided at every step; final step corrected
+    corrections: list             # per-step corrections from guided pass
+    posthoc_correction: object    # single correction applied to final unguided actions
+    v_t_unguided: list            # velocity predictions from unguided pass
+    v_t_guided: list              # velocity predictions from guided pass
+    eef_pos: np.ndarray
+    obs_pos: np.ndarray
+    
+    def to_dict(self):
+        def convert(lst):
+            return [x.cpu().numpy() if hasattr(x, 'cpu') else np.asarray(x) for x in lst]
+        
+        def convert_single(x):
+            if x is None:
+                return None
+            return x.cpu().numpy() if hasattr(x, 'cpu') else np.asarray(x)
+        
+        return {
+            'flow_times': self.flow_times,
+            'unguided_x_t': convert(self.unguided_x_t),
+            'guided_x_t': convert(self.guided_x_t),
+            'posthoc_x_t': convert(self.posthoc_x_t),
+            'corrections': convert(self.corrections),
+            'posthoc_correction': convert_single(self.posthoc_correction),
+            'v_t_unguided': convert(self.v_t_unguided),
+            'v_t_guided': convert(self.v_t_guided),
+            'eef_pos': self.eef_pos,
+            'obs_pos': self.obs_pos,
+        }
