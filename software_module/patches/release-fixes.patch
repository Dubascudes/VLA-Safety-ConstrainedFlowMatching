+
+    def set_trace_dir(self, trace_dir: str | pathlib.Path | None):
+        """Opt into trace collection; relative paths resolve against server cwd."""
+        self._trace_dir = pathlib.Path(trace_dir).expanduser().resolve() if trace_dir is not None else None
+
+    def _save_current_trace(self):
+        import json
+        import uuid
+
+        trace = getattr(self._model, '_last_trace', None)
+        if trace is None:
+            return
+        try:
+            if self._trace_dir is None:
+                return
+            def encode(value):
+                if hasattr(value, 'detach'):
+                    return value.detach().cpu().tolist()
+                if hasattr(value, 'tolist'):
+                    return value.tolist()
+                raise TypeError(f'Unsupported trace value: {type(value).__name__}')
+            payload = json.dumps(trace.to_dict(), default=encode, allow_nan=False)
+            self._trace_dir.mkdir(parents=True, exist_ok=True)
+            path = self._trace_dir / f'trace_{uuid.uuid4().hex}.json'
+            with path.open('x') as stream:
+                stream.write(payload)
+        finally:
+            self._model._last_trace = None
 
